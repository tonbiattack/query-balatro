{
  "name": "query-balatro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Balatro系、クエリのパターンで役を作るスコアアタック",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
